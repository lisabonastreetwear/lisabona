# Application
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://bot.example.com
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_bot
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=replace-with-a-random-webhook-token
META_APP_SECRET=replace-with-meta-app-secret
META_ACCESS_TOKEN=replace-with-permanent-system-user-token
META_PHONE_NUMBER_ID=replace-with-phone-number-id
# Set this to the Graph API version enabled for the Meta app, e.g. vXX.X
META_GRAPH_VERSION=

# Shopify Admin GraphQL API
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Para apps atuais no Shopify Dev Dashboard (recomendado)
SHOPIFY_CLIENT_ID=replace-with-client-id
SHOPIFY_CLIENT_SECRET=replace-with-client-secret
# Apenas para uma app legacy criada diretamente no Admin antes de 2026
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# Airtable Web API (read-only token recommended)
AIRTABLE_ACCESS_TOKEN=pat_replace_me
AIRTABLE_BASE_ID=app_replace_me
AIRTABLE_TABLE_ID=tbl_replace_me
AIRTABLE_ORDER_FIELD=Order Number
AIRTABLE_STATUS_FIELD=Status
AIRTABLE_UPDATED_FIELD=Last Update
AIRTABLE_TRACKING_FIELD=Tracking
